# ===================================================================
# Smart Carpool and Ride-Sharing System - Environment Configuration
# ===================================================================
# Copy this file to .env or configure these environment variables in your system

# Server Port
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ridesharing_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# OpenStreetMap Nominatim Geocoding (optional, fallback available)
NOMINATIM_USER_AGENT=SmartCarpoolApp/1.0
